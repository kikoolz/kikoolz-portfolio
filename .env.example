
# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL database connection string (Required for Hostinger)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ===========================================
# REDIS CONFIGURATION  
# ===========================================
# Upstash Redis for caching and analytics (Required)
UPSTASH_REDIS_REST_URL="https://your-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ===========================================
# SITE CONFIGURATION
# ===========================================
# Production site URL (Required for Hostinger)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ===========================================
# AUTHENTICATION
# ===========================================
# JWT secret for authentication (Generate a secure random string)
JWT_SECRET="your-jwt-secret"

# ===========================================
# ANALYTICS
# ===========================================
# Google Analytics Measurement ID (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# FILE UPLOADS
# ===========================================
# UploadThing configuration for file uploads
UPLOADTHING_SECRET="YOUR_UPLOADTHING_SECRET"
UPLOADTHING_APP_ID="your-app-id"
UPLOADTHING_TOKEN="your-uploadthing-token"

# ===========================================
# EMAIL SERVICE
# ===========================================
# Resend email service configuration
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="you@yourdomain.com"

# ===========================================
# HOSTINGER DEPLOYMENT NOTES
# ===========================================
# 1. Set NODE_ENV=production in Hostinger environment
# 2. Ensure all database connections use SSL
# 3. Configure domain names properly in NEXT_PUBLIC_SITE_URL
# 4. Test all API endpoints after deployment
